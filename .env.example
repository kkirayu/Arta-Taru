APP_NAME="Toko Arta Taru"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://artataru.example
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# On Vercel, stdout/stderr is the only durable log stream.
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# ---------------------------------------------------------------------------
# Database — TiDB Cloud Starter (MySQL compatible)
# ---------------------------------------------------------------------------
# Host looks like: gateway01.ap-southeast-1.prod.aws.tidbcloud.com
# Port is 4000 and TLS is mandatory. Mount the CA bundle into the container at
# /app/storage/certs/isrgrootx1.pem (see Dockerfile).
DB_CONNECTION=mysql
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_DATABASE=arta_taru
DB_USERNAME=
DB_PASSWORD=
DB_PERSISTENT=false
MYSQL_ATTR_SSL_CA=/app/storage/certs/isrgrootx1.pem

# ---------------------------------------------------------------------------
# Session & cache — must be shared across stateless containers
# ---------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=sync

# ---------------------------------------------------------------------------
# Storage — S3 compatible (Cloudflare R2 / Supabase Storage)
# ---------------------------------------------------------------------------
FILESYSTEM_DISK=s3
PRODUCT_IMAGES_DISK=s3
PAYMENT_PROOF_DISK=s3_private

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

# ---------------------------------------------------------------------------
# Mail — Resend (recommended) or Brevo SMTP
# ---------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@artataru.example"
MAIL_FROM_NAME="${APP_NAME}"

# Secret used by /api/cron/tick (external cron: cron-job.org, UptimeRobot)
CRON_SECRET=

# Optional error tracking (Hobby keeps only 1 hour of runtime logs)
SENTRY_LARAVEL_DSN=

VITE_APP_NAME="${APP_NAME}"
